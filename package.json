    "test:media": "node --test tests/media.mjs tests/media-ui.mjs tests/trailer-preview.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "dependencies": {
    "@vercel/functions": "^3.9.11",
    "better-auth": "^1.7.7",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  }
}
