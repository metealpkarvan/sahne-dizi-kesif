{
  "name": "sahne-dizi-kesif",
  "version": "1.0.0",
  "private": true,
  "description": "Sahne dizi keşfi ve kişisel izleme günlüğü",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node tests/recommendations.cjs",
    "dev": "node --env-file=.env.local scripts/dev.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "test:community": "node --env-file=.env.local tests/community.mjs",
